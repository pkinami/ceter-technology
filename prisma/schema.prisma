generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String               @id @default(cuid())
  name            String
  email           String               @unique
  role            Role                 @default(CUSTOMER)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  adminLogs       AdminLog[]           @relation("AdminLogs")
  events          AnalyticsEvent[]
  auditLogs       AuditLog[]           @relation("AuditLogActor")
  imports         ImportHistory[]      @relation("ImportHistoryAdmin")
  orders          Order[]
  views           ProductView[]
  roleAssignments UserRoleAssignment[] @relation("UserRoleAssignments")
}

model UserRole {
  id          String               @id @default(cuid())
  name        String               @unique
  slug        String               @unique
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[] @relation("RoleAssignments")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      PermissionModule
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         UserRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String?
  createdAt  DateTime @default(now())
  role       UserRole @relation("RoleAssignments", fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model Category {
  id             String                      @id @default(cuid())
  name           String                      @unique
  slug           String                      @unique @default(cuid())
  description    String?
  parentId       String?
  sortOrder      Int                         @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?
  version        Int                         @default(1)
  parent         Category?                   @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]                  @relation("CategoryTree")
  products       Product[]
  campaigns      MarketingCampaignCategory[]

  @@index([parentId, sortOrder])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Product {
  id                     String                     @id @default(cuid())
  name                   String
  slug                   String                     @unique @default(cuid())
  description            String
  sku                    String?
  brand                  String                     @default("")
  costPrice              Decimal?                   @db.Decimal(12, 2)
  price                  Decimal                    @db.Decimal(10, 2)
  discountPrice          Decimal?                   @db.Decimal(10, 2)
  taxRate                Decimal                    @default(16) @db.Decimal(5, 2)
  stock                  Int                        @default(0)
  lowStockThreshold      Int                        @default(5)
  supplierId             String?
  warehouseLocation      String?
  status                 ProductStatus              @default(DRAFT)
  badges                 ProductBadge[]             @default([])
  imageUrl               String?
  imageFolder            String?
  modelNumber            String?
  manufacturer           String?
  manufacturerProductUrl String?
  datasheetUrl           String?
  warranty               String?
  barcode                String?
  homepagePlacement      String?
  specifications         Json?
  categoryId             String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  archivedAt             DateTime?
  deletedAt              DateTime?
  version                Int                        @default(1)
  inventoryLogs          InventoryLog[]
  marketPriceIndex       MarketPriceIndex?
  campaigns              MarketingCampaignProduct[]
  media                  Media[]
  orderItems             OrderItem[]
  priceHistory           PriceHistory[]
  category               Category                   @relation(fields: [categoryId], references: [id])
  supplier               Supplier?                  @relation("PrimarySupplierProducts", fields: [supplierId], references: [id], onDelete: SetNull)
  views                  ProductView[]
  quoteRequests          QuoteRequest[]
  stockMovements         StockMovement[]
  supplierProducts       SupplierProduct[]

  @@index([slug])
  @@index([sku])
  @@index([modelNumber])
  @@index([manufacturer])
  @@index([barcode])
  @@index([brand])
  @@index([categoryId])
  @@index([supplierId])
  @@index([createdAt])
  @@index([brand, status])
  @@index([categoryId, status])
  @@index([status])
  @@index([stock])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Order {
  id               String               @id @default(cuid())
  userId           String?
  orderNumber      String               @unique
  totalAmount      Decimal              @db.Decimal(10, 2)
  paymentStatus    PaymentStatus        @default(PENDING)
  orderStatus      OrderStatus          @default(PENDING)
  paymentMethod    String
  customerName     String
  customerEmail    String
  customerPhone    String
  deliveryAddress  String
  city             String
  country          String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  archivedAt       DateTime?
  version          Int                  @default(1)
  deliveryInfo     Json?
  deliveryProvider String?
  deliveryStatus   DeliveryStatus       @default(PENDING)
  internalNotes    String?
  trackingNumber   String               @unique
  user             User?                @relation(fields: [userId], references: [id])
  issues           OrderIssue[]
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payments         Payment[]
  stockMovements   StockMovement[]

  @@index([userId])
  @@index([orderNumber])
  @@index([trackingNumber])
  @@index([customerName])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([archivedAt])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  note           String?
  changedBy      String?
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model OrderIssue {
  id        String   @id @default(cuid())
  orderId   String
  title     String
  status    String   @default("OPEN")
  note      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  transactionId String?
  paymentMethod String
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
}

model Media {
  id                 String    @id @default(cuid())
  productId          String?
  url                String
  fileName           String    @default("")
  fileType           String    @default("image/jpeg")
  fileSize           Int       @default(0)
  storagePath        String    @default("")
  type               MediaType @default(IMAGE)
  sha256             String?
  source             String    @default("MANUAL")
  width              Int?
  height             Int?
  isPrimary          Boolean   @default(false)
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?
  deletedAt          DateTime?
  version            Int       @default(1)
  cleanupStatus      String    @default("NOT_REQUIRED")
  cleanupError       String?
  cleanupAttempts    Int       @default(0)
  cleanupLastTriedAt DateTime?
  product            Product?  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([fileType])
  @@index([sha256])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([cleanupStatus])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  timestamp DateTime @default(now())
  admin     User     @relation("AdminLogs", fields: [adminId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorName     String
  action        String
  module        String
  entityType    String?
  entityId      String?
  field         String?
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  actor         User?    @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ImportHistory {
  id                     String    @id @default(cuid())
  type                   String
  fileName               String
  totalRows              Int
  importedRecords        Int
  failedRecords          Int
  errorReport            Json?
  originalFileBucket     String?
  originalFilePath       String?
  errorReportBucket      String?
  errorReportPath        String?
  fileCleanupStatus      String    @default("NOT_REQUIRED")
  fileCleanupError       String?
  fileCleanupAttempts    Int       @default(0)
  fileCleanupLastTriedAt DateTime?
  adminId                String
  createdAt              DateTime  @default(now())
  archivedAt             DateTime?
  deletedAt              DateTime?
  admin                  User      @relation("ImportHistoryAdmin", fields: [adminId], references: [id])

  @@index([type])
  @@index([adminId])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([fileCleanupStatus])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  eventType AnalyticsEventType
  userId    String?
  metadata  Json?
  createdAt DateTime           @default(now())
  user      User?              @relation(fields: [userId], references: [id])

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  orderId   String?
  change    Int
  reason    String
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderId])
  @@index([createdAt])
}

model MarketingCampaign {
  id                 String                      @id @default(cuid())
  name               String
  campaignType       String                      @default("PRODUCT_PROMOTION")
  discountPercentage Int
  status             CampaignStatus              @default(DRAFT)
  startsAt           DateTime
  endsAt             DateTime
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  archivedAt         DateTime?
  deletedAt          DateTime?
  version            Int                         @default(1)
  products           MarketingCampaignProduct[]
  categories         MarketingCampaignCategory[]

  @@index([campaignType])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model MarketingCampaignProduct {
  campaignId String
  productId  String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([productId])
}

model MarketingCampaignCategory {
  campaignId String
  categoryId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([campaignId, categoryId])
  @@index([categoryId])
}

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountPercentage Int
  minimumOrderAmount Decimal   @default(0) @db.Decimal(10, 2)
  expiresAt          DateTime
  usageLimit         Int?
  usageCount         Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?
  deletedAt          DateTime?
  version            Int       @default(1)

  @@index([code])
  @@index([expiresAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model NewsletterSubscriber {
  id         String    @id @default(cuid())
  email      String    @unique
  source     String    @default("website")
  createdAt  DateTime  @default(now())
  archivedAt DateTime?
  deletedAt  DateTime?
  version    Int       @default(1)

  @@index([createdAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model SiteContent {
  id          String    @id @default(cuid())
  section     String    @unique
  title       String
  description String?
  imageUrl    String?
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?
  version     Int       @default(1)
}

model HomepageBanner {
  id              String    @id @default(cuid())
  title           String
  subtitle        String
  imageUrl        String?
  desktopImageUrl String?
  mobileImageUrl  String?
  offerText       String?
  startsAt        DateTime?
  expiresAt       DateTime?
  primaryLabel    String    @default("Shop Products")
  primaryLink     String    @default("/products")
  secondaryLabel  String    @default("Request a Quote")
  secondaryLink   String    @default("#request-quote")
  isActive        Boolean   @default(true)
  approvalStatus  String    @default("APPROVED")
  provider        String?
  promptVersion   String?
  metadata        Json?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?
  deletedAt       DateTime?
  version         Int       @default(1)

  @@index([isActive, sortOrder])
  @@index([approvalStatus])
  @@index([startsAt, expiresAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  ctaLabel    String    @default("View offer")
  ctaLink     String    @default("/products")
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?
  version     Int       @default(1)

  @@index([isActive, startsAt, endsAt])
  @@index([sortOrder])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Brand {
  id         String    @id @default(cuid())
  name       String    @unique
  logoUrl    String?
  website    String?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
  version    Int       @default(1)

  @@index([isActive, sortOrder])
  @@index([archivedAt])
  @@index([deletedAt])
}

model IndustrySolution {
  id          String    @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  ctaLabel    String    @default("Explore Solutions")
  ctaLink     String    @default("/services")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?
  version     Int       @default(1)

  @@index([isActive, sortOrder])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Service {
  id          String    @id @default(cuid())
  title       String
  description String
  icon        String?
  ctaLink     String    @default("/services")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?
  version     Int       @default(1)

  @@index([isActive, sortOrder])
  @@index([archivedAt])
  @@index([deletedAt])
}

model QuoteRequest {
  id              String    @id @default(cuid())
  name            String
  company         String?
  phone           String
  email           String
  productInterest String?
  message         String
  productId       String?
  status          String    @default("NEW")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?
  deletedAt       DateTime?
  version         Int       @default(1)
  product         Product?  @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([productId])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Testimonial {
  id         String    @id @default(cuid())
  customer   String
  company    String?
  review     String
  rating     Int       @default(5)
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
  version    Int       @default(1)

  @@index([isActive, sortOrder])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Manufacturer {
  id         String        @id @default(cuid())
  name       String        @unique
  slug       String        @unique
  website    String?
  country    SourceCountry @default(INTERNATIONAL)
  priority   Int           @default(100)
  categories String[]      @default([])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
  version    Int           @default(1)

  @@index([priority])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Supplier {
  id              String            @id @default(cuid())
  name            String            @unique
  slug            String            @unique
  country         SourceCountry     @default(KENYA)
  contactName     String?
  email           String?
  phone           String?
  website         String?
  status          IntegrationStatus @default(INACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  archivedAt      DateTime?
  deletedAt       DateTime?
  version         Int               @default(1)
  primaryProducts Product[]         @relation("PrimarySupplierProducts")
  products        SupplierProduct[]

  @@index([status])
  @@index([archivedAt])
  @@index([deletedAt])
}

model SupplierProduct {
  id                String    @id @default(cuid())
  productId         String?
  supplierId        String?
  supplierSku       String?
  modelNumber       String?
  name              String
  brand             String
  costPrice         Decimal?  @db.Decimal(12, 2)
  distributorPrice  Decimal?  @db.Decimal(12, 2)
  currency          String    @default("KES")
  availableQuantity Int?
  leadTimeDays      Int?
  warrantyInfo      String?
  rawData           Json?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?
  deletedAt         DateTime?
  version           Int       @default(1)
  product           Product?  @relation(fields: [productId], references: [id])
  supplier          Supplier? @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@index([supplierSku])
  @@index([modelNumber])
  @@index([archivedAt])
  @@index([deletedAt])
}

model PriceHistory {
  id                    String   @id @default(cuid())
  productId             String
  source                String
  costPrice             Decimal? @db.Decimal(12, 2)
  marketPrice           Decimal? @db.Decimal(12, 2)
  recommendedPrice      Decimal  @db.Decimal(12, 2)
  currency              String   @default("KES")
  exchangeRate          Decimal? @db.Decimal(12, 4)
  operatingCostAmount   Decimal  @default(0) @db.Decimal(12, 2)
  targetMarginPercent   Decimal  @db.Decimal(5, 2)
  kenyaMarketAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  reason                String?
  createdAt             DateTime @default(now())
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model MarketPriceIndex {
  id                    String   @id @default(cuid())
  productId             String   @unique
  averageKenyaPrice     Decimal  @db.Decimal(12, 2)
  lowestMarketPrice     Decimal  @db.Decimal(12, 2)
  highestMarketPrice    Decimal  @db.Decimal(12, 2)
  recommendedCeterPrice Decimal  @db.Decimal(12, 2)
  sampleSize            Int      @default(0)
  sources               Json?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model PriceRule {
  id                     String         @id @default(cuid())
  name                   String
  scope                  PriceRuleScope @default(GLOBAL)
  categoryId             String?
  brand                  String?
  productId              String?
  targetMarginPercent    Decimal        @db.Decimal(5, 2)
  operatingCostPercent   Decimal        @default(0) @db.Decimal(5, 2)
  kenyaAdjustmentPercent Decimal        @default(0) @db.Decimal(5, 2)
  minimumMarginAmount    Decimal        @default(0) @db.Decimal(12, 2)
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  archivedAt             DateTime?
  deletedAt              DateTime?
  version                Int            @default(1)

  @@index([scope])
  @@index([categoryId])
  @@index([brand])
  @@index([productId])
  @@index([isActive])
  @@index([archivedAt])
  @@index([deletedAt])
}

model InventoryLog {
  id                 String   @id @default(cuid())
  productId          String
  supplierProductId  String?
  warehouseQuantity  Int      @default(0)
  supplierQuantity   Int      @default(0)
  availableQuantity  Int      @default(0)
  restockRecommended Boolean  @default(false)
  note               String?
  createdAt          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([supplierProductId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  CUSTOMER
}

enum PermissionModule {
  PRODUCTS
  ORDERS
  CUSTOMERS
  REPORTS
  SETTINGS
  USERS
  ROLES
  PERMISSIONS
  CATEGORIES
  MEDIA
  MARKETING
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  BULK
  CANCEL
  UPDATE_STATUS
  EXPORT
  MANAGE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  READY_FOR_DISPATCH
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_STARTED
  PURCHASE
  NEWSLETTER_SUBSCRIBE
}

enum ProductBadge {
  FEATURED
  NEW_ARRIVAL
  BEST_SELLER
  PROMOTION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum SourceCountry {
  KENYA
  INTERNATIONAL
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
}

enum PriceRuleScope {
  GLOBAL
  CATEGORY
  BRAND
  PRODUCT
}
